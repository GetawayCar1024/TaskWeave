{
  "name": "polyforge",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @polyforge/server --filter @polyforge/web dev",
    "build": "pnpm --filter @polyforge/web build",
    "start": "pnpm build && pnpm --filter @polyforge/server start",
    "typecheck": "pnpm -r typecheck",
    "desktop": "pnpm build && node scripts/build-desktop.mjs",
    "desktop:run": "pnpm build && node scripts/build-desktop.mjs --app-only && pnpm --filter @polyforge/desktop exec electron app"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
